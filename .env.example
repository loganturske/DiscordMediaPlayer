# Docker Compose reads .env automatically. For a native Python run, export these
# into the process environment; the Python bot does not load .env itself.
DISCORD_TOKEN=
# Optional: sync commands immediately to one development server.
DISCORD_GUILD_ID=
# Keep true on first deployment and after changing slash commands.
SYNC_COMMANDS=true
# Optional comma-separated trusted server IDs. Recommended with YouTube cookies.
ALLOWED_GUILD_IDS=
YOUTUBE_COOKIE_FILE=data/youtube-cookies.txt
# Conservative local/container default. Increase only after measuring host load.
MAX_PLAYERS=5
MAX_QUEUE_SIZE=10000
PLAY_COOLDOWN_SECONDS=5
IDLE_TIMEOUT=300
EMPTY_CHANNEL_TIMEOUT=60
