# Install as /etc/discord-media-player.env, owned by root with mode 0600.
# systemd reads this file; shell `export` and shell substitutions are not supported.
DISCORD_TOKEN=
# Strongly recommended when YouTube cookies are configured: trusted server IDs.
ALLOWED_GUILD_IDS=
# Leave unset/blank for global commands. Set only for a development server.
DISCORD_GUILD_ID=
SYNC_COMMANDS=true
# Conservative starting capacity for the supplied 2 GiB service limit.
MAX_PLAYERS=5
MAX_QUEUE_SIZE=10000
PLAY_COOLDOWN_SECONDS=5
IDLE_TIMEOUT=300
EMPTY_CHANNEL_TIMEOUT=60
# The unit sets YOUTUBE_COOKIE_FILE to the persistent state directory.
